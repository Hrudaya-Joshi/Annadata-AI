# ANNADATA AI — Environment Configuration Example
# Copy this file to .env and insert your project credentials

# Flask secret key for sessions and CSRF
SECRET_KEY=change_this_secret_key_in_production

# Database URL (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///foodwaste.db

# OpenRouter API Key for LLM assistance (Optional - deterministic offline fallback included)
OPENROUTER_API_KEY=

# OpenRouter model identifier
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# Nominatim / Geocoding user agent
GEOCODER_USER_AGENT=ANNADATA-AI/1.0
